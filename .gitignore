# ── Build outputs (always regenerated by colcon build) ──
ardu_ws/build/
ardu_ws/install/
ardu_ws/log/

# ── ArduPilot runtime files (generated on each run) ──
*.tlog
*.tlog.raw
eeprom.bin
*.bin

# ── Crash dumps ──
dumpcore.*
dumpstack.*

# ── ArduPilot source packages (cloned separately, not stored here) ──
ardu_ws/src/ardupilot/
ardu_ws/src/ardupilot_gazebo/
ardu_ws/src/ardupilot_gz/
ardu_ws/src/ardupilot_sitl_models/
ardu_ws/src/ros_gz/
ardu_ws/src/sdformat_urdf/

# ── Not part of drone system (belongs in pi-archive) ──
teknic/

# ── Python cache ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# ── OS / editor files ──
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ── Logs (optional — remove these lines if you want logs tracked) ──
logs/
*.log
